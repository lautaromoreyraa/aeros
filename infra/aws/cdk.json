{
  "app": "npx tsx bin/aeros.ts",
  "watch": {
    "include": ["bin/**", "lib/**", "lambdas/**"],
    "exclude": ["**/__pycache__", "**/tests/**", "cdk.out", "node_modules"]
  },
  "context": {
    "aeros:githubRepository": "lautaromoreyraa/aeros",
    "aeros:deployBranch": "main",
    "aeros:allowedOrigins": ["https://aeros.lautaromoreyra.dev", "http://localhost:5173"],
    "aeros:firmsSecretName": "aeros/firms-map-key",
    "aeros:firmsArea": "-74,-56,-53,-21",
    "aeros:createGithubOidcProvider": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true
  }
}
