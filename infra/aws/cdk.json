{
  "app": "npx tsx bin/aeros.ts",
  "watch": {
    "include": [
      "bin/**",
      "lib/**",
      "lambdas/**"
    ],
    "exclude": [
      "**/__pycache__",
      "**/tests/**",
      "cdk.out",
      "node_modules"
    ]
  },
  "context": {
    "region": "us-east-1",
    "aeros:githubRepository": "lautaromoreyraa/aeros",
    "aeros:deployBranch": "main",
    "aeros:firmsMapKeyParameter": "/aeros/firms/map-key",
    "aeros:firmsArea": "-69,-35,-53,-16",
    "aeros:webUrl": "https://aeros.lautaromoreyra.dev",
    "aeros:alertRegionName": "Southern Cone of South America",
    "aeros:createGithubOidcProvider": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "@aws-cdk/core:target-partitions": [
      "aws"
    ],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "aeros:rawRetentionDays": 90,
    "aeros:apiReservedConcurrency": 0,
    "aeros:refreshReservedConcurrency": 0,
    "aeros:budgetLimitUsd": 1
  }
}
