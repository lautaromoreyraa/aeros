{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeros-team-context",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "mcp.aeros.lautaromoreyra.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeros-team-context",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "DATA_BASE_URL": "https://aeros.lautaromoreyra.dev/data"
  }
  // Secret, set with `wrangler secret put ACCESS_AUD`: the Access application audience tag.
}
